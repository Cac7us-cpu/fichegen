# Copie ce fichier en .env puis remplis les valeurs.
# NE JAMAIS envoyer le fichier .env sur GitHub (il est dans .gitignore).

NOM_SERVICE=FicheGen
URL_SITE=http://localhost:8000
# Génère-la avec : python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Clé API Anthropic (console.anthropic.com). Vide = mode démo (fausse fiche).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Stripe (dashboard.stripe.com > Développeurs). Commence avec les clés de TEST (sk_test_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CONTACT_EMAIL=contact@example.com
RESPONSABLE_RP=Le fondateur de FicheGen

# Limites
CREDITS_GRATUITS=2
TAILLE_MAX_MO=25
FICHES_PAR_HEURE=6
FICHES_PAR_JOUR_TOTAL=300
CHEMIN_BD=donnees/fichegen.db
MODE_DEMO=0
